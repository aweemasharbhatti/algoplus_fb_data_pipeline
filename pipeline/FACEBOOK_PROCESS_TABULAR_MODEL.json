{
	"name": "FACEBOOK_PROCESS_TABULAR_MODEL",
	"properties": {
		"activities": [
			{
				"name": "LoadMetaData",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "SqlServerSource",
						"sqlReaderQuery": "select TenantID, AzureASClientID, AzureASClientSecret, SubscriptionID,\nAzureASRegion, AzureASServer, AzureASDatabase\nfrom (\nselect ObjectValue 'TenantID' from log.AzureCredentials\nwhere ObjectKey = 'TenantID') t1,\n(\nselect ObjectValue 'AzureASClientID' from log.AzureCredentials\nwhere ObjectKey = 'AzureASClientID') t2,\n(\nselect ObjectValue 'AzureASClientSecret' from log.AzureCredentials\nwhere ObjectKey = 'AzureASClientSecret') t3,\n(\nselect ObjectValue 'SubscriptionID' from log.AzureCredentials\nwhere ObjectKey = 'SubscriptionID') t4,\n(\nselect ObjectValue 'AzureASRegion' from log.AzureCredentials\nwhere ObjectKey = 'AzureASRegion') t5,\n(\nselect ObjectValue 'AzureASServer' from log.AzureCredentials\nwhere ObjectKey = 'AzureASServer') t6,\n(\nselect ObjectValue 'AzureASDatabase' from log.AzureCredentials\nwhere ObjectKey = 'AzureASDatabase') t7;",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_ALGO_PLUS_FB_EDW_DEV_LAND",
						"type": "DatasetReference",
						"parameters": {
							"SchemaName": "NULL",
							"TableName": "NULL"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Login",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "LoadMetaData",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/x-www-form-urlencoded"
					},
					"url": {
						"value": "@concat('https://login.microsoftonline.com/',activity('LoadMetaData').output.value[0].TenantID,'/oauth2/token')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "integration-runtime-facebook-dp-new",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"value": "@concat('grant_type=client_credentials&resource=https://*.asazure.windows.net&client_id=',activity('LoadMetaData').output.value[0].AzureASClientID,'&client_secret=',activity('LoadMetaData').output.value[0].AzureASClientSecret)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "StartProcessingAzureAS",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Login",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Authorization": {
							"value": "@concat(string(activity('Login').output.token_type),' ',string(activity('Login').output.access_token))",
							"type": "Expression"
						}
					},
					"url": {
						"value": "@concat('https://',activity('LoadMetaData').output.value[0].AzureASRegion,'.asazure.windows.net/servers/',activity('LoadMetaData').output.value[0].AzureASServer,'/models/',activity('LoadMetaData').output.value[0].AzureASDatabase,'/refreshes')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "integration-runtime-facebook-dp-new",
						"type": "IntegrationRuntimeReference"
					},
					"body": {
						"value": "{\"Type\":\"Full\",\"CommitMode\":\"transactional\",\"MaxParallelism\":8,\"RetryCount\":2,\"Objects\":[{\"table\":\"DIM_DATE\",\"partition\":\"Partition\"},{\"table\":\"DIM_ITEM\",\"partition\":\"Partition\"},{\"table\":\"DIM_RETAILER\",\"partition\":\"Partition\"},{\"table\":\"FACT_INVENTORY_ACCOUNT\",\"partition\":\"Partition\"},{\"table\":\"FACT_INVENTORY_DISTRIBUTOR\",\"partition\":\"Partition\"},{\"table\":\"ITEM_ACCOUNT_RELATION\",\"partition\":\"Partition\"},\n{\"table\":\"V_FORECAST_ACCURACY_MART\",\"partition\":\"Partition\"},\n{\"table\":\"DIM_DISTRIBUTOR\",\"partition\":\"Partition\"},\n{\"table\":\"FACT_ORDER\",\"partition\":\"Partition\"},\n{\"table\":\"FACT_SALE\",\"partition\":\"Partition\"},\n{\"table\":\"V_META_FORECAST_NARRATIVE\",\"partition\":\"Partition\"}]}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "GetAzureASRefreshes",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "StartProcessingAzureAS",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"headers": {
						"Authorization": {
							"value": "@concat(string(activity('Login').output.token_type),' ',string(activity('Login').output.access_token))",
							"type": "Expression"
						}
					},
					"url": {
						"value": "@concat('https://',activity('LoadMetaData').output.value[0].AzureASRegion,'.asazure.windows.net/servers/',activity('LoadMetaData').output.value[0].AzureASServer,'/models/',activity('LoadMetaData').output.value[0].AzureASDatabase,'/refreshes')",
						"type": "Expression"
					},
					"connectVia": {
						"referenceName": "integration-runtime-facebook-dp-new",
						"type": "IntegrationRuntimeReference"
					}
				}
			},
			{
				"name": "FilterToCurrentRefresh",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "GetAzureASRefreshes",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json(activity('GetAzureASRefreshes').output.Response)",
						"type": "Expression"
					},
					"condition": {
						"value": "@greaterOrEquals(item().startTime,addseconds(activity('StartProcessingAzureAS').output.startTime,-30))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "UntilRefreshComplete",
				"type": "Until",
				"dependsOn": [
					{
						"activity": "FilterToCurrentRefresh",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('GetAzureASRefreshStatus').output.status,'inProgress'))",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Wait30Seconds",
							"type": "Wait",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 10
							}
						},
						{
							"name": "GetAzureASRefreshStatus",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "Wait30Seconds",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"headers": {
									"Authorization": {
										"value": "@concat(string(activity('Login').output.token_type),' ',string(activity('Login').output.access_token))",
										"type": "Expression"
									}
								},
								"url": {
									"value": "@concat('https://',activity('LoadMetaData').output.value[0].AzureASRegion,'.asazure.windows.net/servers/',activity('LoadMetaData').output.value[0].AzureASServer,'/models/',activity('LoadMetaData').output.value[0].AzureASDatabase,'/refreshes/',activity('FilterToCurrentRefresh').output.Value[0].refreshId)",
									"type": "Expression"
								},
								"connectVia": {
									"referenceName": "integration-runtime-facebook-dp-new",
									"type": "IntegrationRuntimeReference"
								}
							}
						}
					],
					"timeout": "7.00:00:00"
				}
			},
			{
				"name": "IfFailed",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "UntilRefreshComplete",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@equals(activity('GetAzureASRefreshStatus').output.status,'failed')",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Error",
							"type": "Wait",
							"dependsOn": [
								{
									"activity": "FB_CUBE_PIPELINE_FAILURE_EMAIL",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"waitTimeInSeconds": 5
							}
						},
						{
							"name": "FB_CUBE_PIPELINE_FAILURE_EMAIL",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "7.00:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"url": "https://prod-81.eastus.logic.azure.com:443/workflows/3a52b8da1cb74de792ee0f9e3ca89d06/triggers/manual/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2Fmanual%2Frun&sv=1.0&sig=rsPHuDvp742N7C3vA0ICmS-a5vT8EW_sr-lkDPwOwdA",
								"connectVia": {
									"referenceName": "integration-runtime-facebook-dp-new",
									"type": "IntegrationRuntimeReference"
								},
								"body": {
									"Subject": "Pipeline [FACEBOOK_PROCESS_TABULAR_MDEL_PIPELINE] has been failed",
									"Message": "The pipeline run is failed please visit ADF-FB-Algoplus-DEV"
								}
							}
						}
					]
				}
			}
		],
		"folder": {
			"name": "Facebook Pipelines"
		},
		"annotations": [],
		"lastPublishTime": "2022-11-07T11:20:33Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}