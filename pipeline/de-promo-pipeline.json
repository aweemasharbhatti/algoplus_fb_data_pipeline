			},
			"cluster_type": {
				"type": "string",
				"defaultValue": "Standard_DS3_v2"
			},
			"worker_node": {
				"type": "string",
				"defaultValue": "2"
			},
			"source_table": {
				"type": "string",
				"defaultValue": "v_fact_sale"
			},
			"source_schema": {
				"type": "string",
				"defaultValue": "dbo"
			},
			"promo_weeks_before": {
				"type": "string",
				"defaultValue": "7"
			},
			"calender_schema": {
				"type": "string",
				"defaultValue": "engine"
			},
			"calender_table": {
				"type": "string",
				"defaultValue": "promo_calender"
			},
			"calender_file": {
				"type": "string",
				"defaultValue": "promo_calendar.csv"
			},
			"promo_weeks_after": {
				"type": "string",
				"defaultValue": "7"
			}
		},
		"folder": {
			"name": "MuddaserTalal"
		},
		"annotations": [],
