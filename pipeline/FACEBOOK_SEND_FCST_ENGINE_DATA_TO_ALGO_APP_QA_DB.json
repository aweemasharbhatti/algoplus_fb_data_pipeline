						"type": "SqlServerSource",
						"sqlReaderQuery": {
							"value": "insert into fcst_pos_forecast_data (itemid, Channelid, Calendarid, [seasonality_type],[toolbox_forecast_type],[customer_code],[item_code],[week_date],[week_number],[lookback_window],\n[reseason_and_repromo_forecast],[algo_created_date])\nselect im.itemManagerId itemid, ic.ItemAccountId Channelid, c.CalendarId Calendarid,\n [seasonality_type],[toolbox_forecast_type],[customer_code],[item_code],[week_date],'0',7,[reseason_and_repromo_forecast],getdate()\nfrom [dbo].FACT_ALGO_BASELINE_FORECAST_EDW fs\ninner join itemaccount ic WITH (NOLOCK) on ic.AccountName = fs.customer_code\ninner join itemmanager im  WITH (NOLOCK) on im.SKU = fs.item_code\ninner join calendar c WITH (NOLOCK) on DATEADD(DD,-6,c.WeekStartDate) = CAST(fs.week_date AS Date);\nselect 1;\n",
