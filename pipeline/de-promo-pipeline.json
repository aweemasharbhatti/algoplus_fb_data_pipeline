{
	"name": "de-promo-pipeline",
	"properties": {
		"activities": [
			{
				"name": "Copy To SQL",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Notebook_De_Promo",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFolderPath": {
								"value": "@concat(pipeline().parameters.target_folder,'/',pipeline().parameters.target_file)",
								"type": "Expression"
							},
							"wildcardFileName": "*.csv",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"preCopyScript": {
							"value": "@{concat('delete from ',pipeline().parameters.target_schema,'.',pipeline().parameters.target_table)}",
							"type": "Expression"
						},
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "CSVSinkDatasetDev",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@pipeline().parameters.target_folder",
								"type": "Expression"
							},
							"file": {
								"value": "@pipeline().parameters.target_file",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "AzureSqlDBDEV",
						"type": "DatasetReference",
						"parameters": {
							"schema": {
								"value": "@pipeline().parameters.target_schema",
								"type": "Expression"
							},
							"table": {
								"value": "@pipeline().parameters.target_table",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Copy Calendar From SQL",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "select retailerkey as endcustomersfid,sku as item_no,cast(startdate as date) as promo_start_date ,cast(enddate as date) as promo_end_date,weeksbeforepromo,weeksafterpromo,cast(status as int) as promo_status from engine.[v_promotionplanner_depromo]\n",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzureSqlDBDEV",
						"type": "DatasetReference",
						"parameters": {
							"schema": {
								"value": "@pipeline().parameters.calender_schema",
								"type": "Expression"
							},
							"table": {
								"value": "@pipeline().parameters.calender_table",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "CSVSinkDatasetDev",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@pipeline().parameters.source_folder",
								"type": "Expression"
							},
							"file": {
								"value": "@pipeline().parameters.calender_file",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Copy sales From SQL",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Copy Calendar From SQL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzureSqlDBDEV",
						"type": "DatasetReference",
						"parameters": {
							"schema": {
								"value": "@pipeline().parameters.source_schema",
								"type": "Expression"
							},
							"table": {
								"value": "@pipeline().parameters.source_table",
								"type": "Expression"
							}
						}
					}
				],
				"outputs": [
					{
						"referenceName": "CSVSinkDatasetDev",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@pipeline().parameters.source_folder",
								"type": "Expression"
							},
							"file": {
								"value": "@pipeline().parameters.source_file",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Notebook_De_Promo",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Copy sales From SQL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/muddaser.talal@algo.com/de-promo-engine/de-promo",
					"baseParameters": {
						"input_file_name": {
							"value": "@pipeline().parameters.source_file",
							"type": "Expression"
						},
						"source_file_path": {
							"value": "@pipeline().parameters.source_folder",
							"type": "Expression"
						},
						"target_file": {
							"value": "@pipeline().parameters.target_file",
							"type": "Expression"
						},
						"target_folder": {
							"value": "@pipeline().parameters.target_folder",
							"type": "Expression"
						},
						"promo_calendar_folder": {
							"value": "@pipeline().parameters.source_folder",
							"type": "Expression"
						},
						"promo_calendar_file": {
							"value": "@pipeline().parameters.calender_file",
							"type": "Expression"
						},
						"promo_weeks_after": {
							"value": "@pipeline().parameters.promo_weeks_after",
							"type": "Expression"
						},
						"promo_weeks_before": {
							"value": "@pipeline().parameters.promo_weeks_before",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureDatabrickslinkserviceUpdated",
					"type": "LinkedServiceReference",
					"parameters": {
						"clusterType": {
							"value": "@pipeline().parameters.cluster_type",
							"type": "Expression"
						},
						"workerNode": {
							"value": "@pipeline().parameters.worker_node",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Delete Datalake files",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "Copy To SQL",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "7.00:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DeleteCSVSinkDatasetDev",
						"type": "DatasetReference",
						"parameters": {
							"folder": {
								"value": "@pipeline().parameters.source_folder",
								"type": "Expression"
							}
						}
					},
					"enableLogging": false,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"parameters": {
			"source_folder": {
				"type": "string",
				"defaultValue": "depromo"
			},
			"source_file": {
				"type": "string",
				"defaultValue": "Factsale.csv"
			},
			"target_folder": {
				"type": "string",
				"defaultValue": "depromo/output"
			},
			"target_file": {
				"type": "string",
