{
	"name": "Master_Forecast_Run",
	"properties": {
		"description": "Master Pipeline for Forecast",
		"activities": [
			{
				"name": "GetForecastConfigs",
				"description": "read configs from DB table",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "[engine].[GetActiveForecastPipelineConfig]",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSQLDynamic",
						"type": "DatasetReference",
						"parameters": {
							"server": "sqlserver-dataplatform-general-dev.database.windows.net",
							"schema": "engine",
							"table": "ForecastPipelineConfig",
							"DB": "dwh-meta-dev",
							"User": "sqladmin",
							"Password": "sCSmjvUoFIhEh2S"
						}
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Set ForecastConfigs",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "GetForecastConfigs",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "ConfigValues",
					"value": {
						"value": "@activity('GetForecastConfigs').output.value",
						"type": "Expression"
					}
				}
			},
			{
				"name": "check forecast run is enable",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Check Generate Forecast Status",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@activity('GetForecastConfigs').output.value[0].IsForecastRun",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Copy data",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderStoredProcedureName": "[engine].[ForecastpipelineData]",
									"storedProcedureParameters": {
										"PforecastKey": {
											"type": "String",
											"value": {
												"value": "@activity('Generate Forecast ItemAccount and Key').output.firstRow.ForecastKey",
												"type": "Expression"
											}
										}
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"sink": {
									"type": "DelimitedTextSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "DelimitedTextWriteSettings",
										"quoteAllText": true,
										"fileExtension": ".txt"
									}
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "AzureSQLDynamic",
									"type": "DatasetReference",
									"parameters": {
										"server": {
											"value": "@activity('GetForecastConfigs').output.value[0].ServerName",
											"type": "Expression"
										},
										"schema": {
											"value": "@activity('GetForecastConfigs').output.value[0].TargetSchema",
											"type": "Expression"
										},
										"table": "temp",
										"DB": {
											"value": "@activity('GetForecastConfigs').output.value[0].DB",
											"type": "Expression"
										},
										"User": {
											"value": "@activity('GetForecastConfigs').output.value[0].UserName",
											"type": "Expression"
										},
										"Password": {
											"value": "@activity('GetForecastConfigs').output.value[0].Password",
											"type": "Expression"
										}
									}
								}
							],
							"outputs": [
								{
									"referenceName": "CSVSinkDatasetV2",
									"type": "DatasetReference",
									"parameters": {
										"folder": {
											"value": "@concat(activity('GetForecastConfigs').output.value[0].Output_Path,'/',activity('Generate Forecast Key').output.firstRow.ForecastKey)",
											"type": "Expression"
										},
										"file": {
											"value": "@activity('GetForecastConfigs').output.value[0].File_Name",
											"type": "Expression"
										},
										"conatiner": {
											"value": "@activity('GetForecastConfigs').output.value[0].ClientName",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			},
			{
				"name": "Generate Forecast Key",
				"type": "Lookup",
				"dependsOn": [
					{
						"activity": "Set ForecastConfigs",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderStoredProcedureName": "[engine].[CalculateForecastItemCombinations_Zaheer]",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSQLDynamic",
						"type": "DatasetReference",
						"parameters": {
							"server": "@activity('GetForecastConfigs').output.value[0].ServerName",
							"schema": "dbo",
							"table": "temp",
							"DB": "@activity('GetForecastConfigs').output.value[0].DB",
							"User": "@activity('GetForecastConfigs').output.value[0].UserName",
							"Password": "@activity('GetForecastConfigs').output.value[0].Password"
						}
					}
				}
			},
			{
				"name": "Check Generate Forecast Status",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Generate Forecast Key",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Generate Forecast Key').output.firstRow.ForecastKey, -1))",
						"type": "Expression"
					}
				}
			}
		],
		"variables": {
			"ConfigValues": {
				"type": "Array"
			},
			"ForecastMethod": {
				"type": "String",
				"defaultValue": "SMA"
			},
			"FromWeek": {
				"type": "String"
			},
			"ToWeek": {
				"type": "String"
			},
			"FixLookbackWeeks": {
				"type": "Boolean"
			},
			"TimePeriod": {
				"type": "String"
			}
		},
		"folder": {
			"name": "poc fcst zaheer"
		},
		"annotations": []
	}
}